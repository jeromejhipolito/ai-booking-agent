# Copy to .env and fill in. Nothing here has a real value committed.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salon_booking

# --- n8n --------------------------------------------------------------------
# Losing this key means losing every stored credential. Back it up somewhere safe.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
DOMAIN=booking.example.com
TZ=Asia/Manila

# --- salon ------------------------------------------------------------------
# The salon's own timezone. The SQL pins Asia/Manila explicitly; change both if you
# deploy elsewhere.
SALON_TZ=Asia/Manila

# --- phase 2+ (chat) --------------------------------------------------------
# Left blank on purpose in phase 1 — the deterministic tools need none of it.
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
MANAGER_TELEGRAM_CHAT_ID=
